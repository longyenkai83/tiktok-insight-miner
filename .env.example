# Required
APIFY_TOKEN=apify_api_your_token_here
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional - mặc định dùng Opus 4.7 theo global rule
# Đổi sang claude-haiku-4-5 cho cost rẻ hơn (~10x cheaper, đủ tốt cho classification)
ANTHROPIC_MODEL=claude-opus-4-7

# Optional
CLASSIFY_BATCH_SIZE=20
DEFAULT_OUTPUT_DIR=./output
APIFY_ACTOR_ID=clockworks/tiktok-comments-scraper

# --- Web UI (v0.3+) ---
# Để trống = open access (chỉ dùng cho LAN nội bộ tin cậy)
# Có giá trị = password gate cho nhân viên
WEBAPP_PASSWORD=

# Quota mỗi user (theo tên/mã NV họ tự nhập trong sidebar) trong 24h
MAX_RUNS_PER_USER_PER_DAY=20

# --- Handoff sang client (CoWork) qua Google Drive sync (v2 Pull model) ---
# Folder Drive Desktop sync local trên PC anh. Tool sẽ snapshot file insight pack
# vào folder này với versioning (insights-pack_v1.md, _v2.md, ...). Drive Desktop
# tự đẩy lên cloud → CoWork máy nào cũng pull được.
#
# Setup:
# 1. Cài Google Drive Desktop: https://www.google.com/drive/download/
# 2. Tạo folder 'tiktok-miner-shared/insights-packs' trên Drive (đã có)
# 3. Drive Desktop sync folder đó về local — note path:
#    Ví dụ Windows: G:\My Drive\tiktok-miner-shared\insights-packs
# 4. Fill vào dòng dưới (giữ nguyên dấu \ trong path Windows)
#
# Bỏ qua (không set) → tool sẽ KHÔNG snapshot, chỉ tạo file ở miner local.
INSIGHTS_PACK_DRIVE_DIR=

# --- Handoff API mode (cho server cloud — Railway/Render/etc.) ---
# Khi deploy lên cloud, KHÔNG có Drive Desktop local → phải upload qua Google Drive API.
#
# Setup:
# 1. Tạo Google Cloud project: https://console.cloud.google.com/
# 2. Enable Google Drive API
# 3. Tạo Service Account: IAM & Admin → Service Accounts → Create
# 4. Tạo JSON key cho service account, download file
# 5. Share Drive folder 'tiktok-miner-shared' với email service account (xxx@xxx.iam.gserviceaccount.com) — quyền Editor
# 6. Set 2 env var dưới đây:
#    - INSIGHTS_PACK_DRIVE_FOLDER_ID = folder ID Drive (vd: 1S27BXGisZTNZ63EgrINDxhMTVvmrue8W)
#    - GDRIVE_SERVICE_ACCOUNT_JSON = nội dung JSON file (paste cả file vào — multi-line)
#
# Ưu tiên: API mode > LOCAL mode > không snapshot
INSIGHTS_PACK_DRIVE_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_JSON=
